<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements template. The Mac App Store workflow
  (.github/workflows/mac-app-store.yml) replaces TEAM_ID with the APPLE_TEAM_ID
  repository variable and BUNDLE_ID with `identifier` from tauri.conf.json.
  For a local App Store build, replace both by hand first.
-->
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>TEAM_ID.BUNDLE_ID</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TEAM_ID</string>
</dict>
</plist>
